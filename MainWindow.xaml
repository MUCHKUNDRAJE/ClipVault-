<Window x:Class="ClipVault.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:ClipVault"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    mc:Ignorable="d"
    Title="ClipVault" Height="400" Width="400" Icon="clipvault.png"
    WindowStyle="None" AllowsTransparency="False" Background="{DynamicResource WindowBg}"
    Topmost="True" ShowInTaskbar="False" WindowStartupLocation="Manual"
    FontFamily="Inter, Segoe UI Variable Display, Segoe UI">

    <Window.Resources>
        <ResourceDictionary>
            <!-- Default Light Theme -->
            <SolidColorBrush x:Key="WindowBg" Color="#F5F5F5" />
            <SolidColorBrush x:Key="ItemBg" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextPrimary" Color="#111111" />
            <SolidColorBrush x:Key="TextSecondary" Color="#666666" />
            <SolidColorBrush x:Key="AccentColor" Color="#0078D4" />
            <SolidColorBrush x:Key="BorderColor" Color="#EEEEEE" />
            <SolidColorBrush x:Key="CodeBg" Color="#F0F0F0" />
            <SolidColorBrush x:Key="CodeText" Color="#444444" />

            <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Ultra-Thin Hairline Scrollbar Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Bg" Background="Transparent" SnapsToDevicePixels="true">
                            <Track x:Name="PART_Track" IsDirectionReversed="true"
                                IsEnabled="{TemplateBinding IsEnabled}">
                                <Track.Thumb>
                                    <Thumb Background="#88FFFFFF">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="2" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Item Entrance Animation -->
        <Storyboard x:Key="ItemEntranceAnim">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase EasingMode="EaseOut" Exponent="5" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                From="20" To="0" Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase EasingMode="EaseOut" Exponent="7" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Style x:Key="TabItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Height" Value="45" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Background="Transparent">
                            <StackPanel VerticalAlignment="Center">
                                <ContentPresenter HorizontalAlignment="Center" x:Name="content" />
                                <Border x:Name="Indicator" Height="2" Width="0"
                                    Background="{DynamicResource AccentColor}" Margin="0,5,0,0" CornerRadius="1" />
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentColor}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Indicator"
                                                Storyboard.TargetProperty="Width" To="15"
                                                Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuarticEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Indicator"
                                                Storyboard.TargetProperty="Width" To="0"
                                                Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="0"
        MouseLeftButtonDown="Window_DragMove">
        <Grid Margin="12,10,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="Auto" /> <!-- Tabs -->
                <RowDefinition Height="*" />    <!-- List -->
            </Grid.RowDefinitions>

            <!-- Header with Title and Mode Toggle -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="clipvault.png" Width="18" Height="18" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Clip Vault" Foreground="{DynamicResource TextPrimary}" FontSize="14" FontWeight="SemiBold"
                        FontFamily="Segoe UI Variable Display" VerticalAlignment="Center" Opacity="0.9"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Padding="5" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="ThemeToggle_Click">
                        <iconPacks:PackIconLucide Kind="SunMoon" Width="16" Height="16" Foreground="{DynamicResource TextSecondary}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Modern Icon Tabs -->
            <ListBox x:Name="TabControl" Grid.Row="1" BorderThickness="0" Background="Transparent"
                SelectionChanged="TabControl_SelectionChanged" Margin="0,0,0,10">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="5" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBoxItem Tag="ALL" Style="{StaticResource TabItemStyle}" IsSelected="True">
                    <StackPanel>
                        <iconPacks:PackIconLucide Kind="ClipboardList" HorizontalAlignment="Center"
                            Width="20" Height="20" />
                        <TextBlock Text="All" FontSize="10" Margin="0,2,0,0"
                            HorizontalAlignment="Center" Opacity="0.7" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="LINK" Style="{StaticResource TabItemStyle}">
                    <StackPanel>
                        <iconPacks:PackIconLucide Kind="Link" HorizontalAlignment="Center"
                            Width="20" Height="20" />
                        <TextBlock Text="Link" FontSize="10" Margin="0,2,0,0"
                            HorizontalAlignment="Center" Opacity="0.7" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="IMAGE" Style="{StaticResource TabItemStyle}">
                    <StackPanel>
                        <iconPacks:PackIconLucide Kind="Image" HorizontalAlignment="Center"
                            Width="20" Height="20" />
                        <TextBlock Text="Image" FontSize="10" Margin="0,2,0,0"
                            HorizontalAlignment="Center" Opacity="0.7" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="CODE" Style="{StaticResource TabItemStyle}">
                    <StackPanel>
                        <iconPacks:PackIconLucide Kind="Code" HorizontalAlignment="Center"
                            Width="20" Height="20" />
                        <TextBlock Text="Code" FontSize="10" Margin="0,2,0,0"
                            HorizontalAlignment="Center" Opacity="0.7" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="TEXT" Style="{StaticResource TabItemStyle}">
                    <StackPanel>
                        <iconPacks:PackIconLucide Kind="FileText" HorizontalAlignment="Center"
                            Width="20" Height="20" />
                        <TextBlock Text="Text" FontSize="10" Margin="0,2,0,0"
                            HorizontalAlignment="Center" Opacity="0.7" />
                    </StackPanel>
                </ListBoxItem>
            </ListBox>

            <!-- List of Clips -->
            <ListBox Grid.Row="2" x:Name="ClipsList" Background="Transparent" BorderThickness="0"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.CanContentScroll="False"
                VirtualizingStackPanel.ScrollUnit="Pixel"
                PreviewMouseWheel="ClipsList_PreviewMouseWheel"
                PreviewMouseLeftButtonDown="ClipsList_PreviewMouseLeftButtonDown">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,0,0,4" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="RenderTransform">
                            <Setter.Value>
                                <TranslateTransform Y="0" />
                            </Setter.Value>
                        </Setter>
                        <Setter Property="ContextMenu">
                            <Setter.Value>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="Copy Content" Click="Copy_Click">
                                        <MenuItem.Icon>
                                            <iconPacks:PackIconLucide Kind="Copy" Width="14" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Delete Clip" Click="Delete_Click">
                                        <MenuItem.Icon>
                                            <iconPacks:PackIconLucide Kind="Trash2" Width="14" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bg" Background="{DynamicResource ItemBg}" CornerRadius="10"
                                        BorderThickness="1" BorderBrush="Transparent" Padding="14,12">
                                        <Grid>
                                            <ContentPresenter />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard
                                                Storyboard="{StaticResource ItemEntranceAnim}" />
                                        </EventTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background"
                                                Value="{DynamicResource BorderColor}" />
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <ThicknessAnimation
                                                            Storyboard.TargetName="Bg"
                                                            Storyboard.TargetProperty="Padding"
                                                            To="18,12,10,12" Duration="0:0:0.2" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <ThicknessAnimation
                                                            Storyboard.TargetName="Bg"
                                                            Storyboard.TargetProperty="Padding"
                                                            To="14,12" Duration="0:0:0.1" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentColor}" />
                                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                                            <Setter Property="Foreground" Value="Black" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" /> <!-- Icon -->
                                <ColumnDefinition Width="*" />    <!-- Content -->
                                <ColumnDefinition Width="Auto" /> <!-- Pin -->
                            </Grid.ColumnDefinitions>

                             <!-- Text Content -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="ContentText" Text="{Binding Preview}" TextWrapping="Wrap"
                                    MaxHeight="40"
                                    FontSize="13" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                            <Setter Property="FontFamily"
                                                Value="Inter, Segoe UI Variable Small, Segoe UI" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Type}" Value="LINK">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentColor}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="CODE">
                                                    <Setter Property="Foreground" Value="{DynamicResource CodeText}" />
                                                    <Setter Property="FontFamily"
                                                        Value="Consolas, Cascadia Code" />
                                                    <Setter Property="Background" Value="{DynamicResource CodeBg}" />
                                                </DataTrigger>
                                                <!-- Click Effect: Force Black text when selected -->
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                    <Setter Property="Foreground" Value="Black" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Image content -->
                                <Image Source="{Binding Content}"
                                    Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}"
                                    MaxHeight="80" Stretch="Uniform" HorizontalAlignment="Left"
                                    Margin="0,6,0,0" />
                            </StackPanel>

                            <!-- Options Button Removed, handled by Item Clicks -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Top"
                                HorizontalAlignment="Right" Margin="8,0,0,0">
                                <TextBlock Text="📌" FontSize="11"
                                    Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}"
                                    HorizontalAlignment="Right" Margin="0,0,0,4" Opacity="0.6" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</Window>