<Window x:Class="ClipVault.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notification" Height="70" Width="300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" WindowStartupLocation="Manual">
    
    <Border Background="#1F1F1F" CornerRadius="8" BorderThickness="1" BorderBrush="#333333" Margin="5">
        <Border.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" X="100"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.3" Color="Black"/>
        </Border.Effect>
        <Grid Margin="12,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- App Identity Header -->
            <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8" Opacity="0.7">
                <Image Source="clipvault.png" Width="14" Height="14" Margin="0,0,8,0"/>
                <TextBlock Text="ClipVault" FontSize="11" FontWeight="Normal" Foreground="#EEEEEE"/>
            </StackPanel>

            <!-- Notification Content -->
            <Grid Grid.Row="1">
                <StackPanel VerticalAlignment="Top">
                    <TextBlock x:Name="TitleText" Text="Copied" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF" Margin="0,0,0,2"/>
                    <TextBlock x:Name="MessageText" Text="Content added to vault" FontSize="12" Foreground="#AAAAAA" TextWrapping="Wrap" MaxHeight="34" LineHeight="16"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
    
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <!-- Slide in from right -->
                    <DoubleAnimation Storyboard.TargetName="SlideTransform" 
                                     Storyboard.TargetProperty="X" From="300" To="0" 
                                     Duration="0:0:0.4">
                        <DoubleAnimation.EasingFunction>
                            <QuadraticEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
                    
                    <!-- Fade out after delay -->
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" BeginTime="0:0:2.5" Duration="0:0:0.5"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>
